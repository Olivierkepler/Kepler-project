PORT=8080

# Required for Firestore / GCP (no silent project fallback)
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Required for Evidence upload/read signed URLs
# Storage: private Evidence / document bucket (also used for Plan Import objects under plan-imports/ paths)
# EVIDENCE_STORAGE_BUCKET=your-project-evidence-bucket

# Field Variance Agent (Phase A2) — Cloud Tasks enqueue
# CLOUD_TASKS_LOCATION=us-central1
# CLOUD_TASKS_QUEUE=field-variance-agent
# AGENT_SERVICE_URL=https://buildsigma-agent-xxxxx.run.app
# CLOUD_TASKS_INVOKER_SERVICE_ACCOUNT_EMAIL=buildsigma-agent-invoker@PROJECT_ID.iam.gserviceaccount.com

# Comma-separated browser origins for Kepler Web CORS (exact origins, no wildcards).
# Runtime source of truth for production is Cloud Run env WEB_ALLOWED_ORIGINS
# (this file alone does not update Cloud Run). Preserve existing production origins
# when merging. Do not use *.
# Local Kepler web defaults to port 3000; 3001 remains supported.
WEB_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,https://ehelectrical.vercel.app

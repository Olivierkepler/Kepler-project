{
  "name": "buildsigma-api",
  "version": "0.1.0",
  "private": true,
  "description": "BUILDSIGMA API service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "firestore:smoke": "tsx src/scripts/firestoreSmokeTest.ts",
    "api:cleanup": "tsx src/scripts/apiSmokeCleanup.ts",
    "auth:ensure-users": "tsx src/scripts/ensureAuthUsers.ts",
    "auth:cleanup": "tsx src/scripts/authOwnershipCleanup.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google-cloud/tasks": "^5.5.2",
    "express": "^5.2.1",
    "firebase-admin": "^14.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}

PORT=8081

# Firebase / GCP (Application Default Credentials)
# GOOGLE_CLOUD_PROJECT=buildsigma-olivier-2026

# Gemini via Google ADK (Gemini Enterprise / Vertex)
# GOOGLE_CLOUD_LOCATION=global
# GEMINI_MODEL=gemini-3.5-flash
# GOOGLE_GENAI_USE_ENTERPRISE=true

# Private Evidence bucket (same as backend EVIDENCE_STORAGE_BUCKET)
# EVIDENCE_STORAGE_BUCKET=buildsigma-olivier-2026-evidence
# MAX_MULTIMODAL_IMAGE_BYTES=8388608

# OIDC — must match A2 Cloud Tasks audience + invoker identity
# AGENT_SERVICE_URL=http://127.0.0.1:8081
# CLOUD_TASKS_INVOKER_SERVICE_ACCOUNT_EMAIL=buildsigma-agent-invoker@PROJECT_ID.iam.gserviceaccount.com

# Local-only OIDC verifier (never disables production verification)
# AGENT_OIDC_MODE=production
# AGENT_OIDC_MODE=local_test
# AGENT_LOCAL_OIDC_SECRET=dev-only-not-for-production

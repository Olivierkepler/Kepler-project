# Expo public config (never put secrets or passwords here).
# Choose the API URL for the target running the app. The backend listens on port 8080.
# iOS Simulator / Mac: http://127.0.0.1:8080
# Android emulator:    http://10.0.2.2:8080
# Physical device:     http://<MAC_LAN_IP>:8080 (same Wi-Fi as the Mac)
# Production:          https://<DEPLOYED_API_URL>
EXPO_PUBLIC_API_URL=http://127.0.0.1:8080

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
